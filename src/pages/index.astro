---
import Layout from "../layouts/Layout.astro";
import Search from "../components/Search";
import Results from "../components/Results";
import Destinations from "../components/Destinations";
---

<Layout>
  <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <section class="grid grid-cols-1 gap-8 pt-12 pb-10 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-12 lg:pt-20">
      <div class="flex flex-col justify-center">
        <p class="eyebrow">Avant d'acheter, connaître le terrain</p>
        <h1
          class="mt-4 font-display text-4xl leading-[1.05] font-medium tracking-tight text-ink sm:text-5xl lg:text-6xl"
        >
          Tout savoir d'une commune,<br class="hidden sm:block" />
          <span class="italic text-accent">en une recherche.</span>
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">
          Risques naturels, qualité de l'eau, commerces, écoles, résultats électoraux,
          statistiques INSEE et climat, rassemblés à partir des données publiques.
        </p>
        <div class="mt-8">
          <Search client:load />
        </div>
      </div>
      <aside>
        <Destinations client:load />
      </aside>
    </section>

    <Results client:load />
  </main>
</Layout>
