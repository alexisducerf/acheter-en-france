---
import Layout from "../layouts/Layout.astro";

const sources = [
  { name: "API Adresse", org: "data.gouv.fr", use: "Géocodage et recherche des communes" },
  { name: "Géorisques", org: "Ministère de la Transition écologique", use: "Risques GASPAR, zonage sismique, sites et sols pollués" },
  { name: "Hub'Eau", org: "OFB / BRGM", use: "Contrôle sanitaire de l'eau potable" },
  { name: "API Recherche d'entreprises", org: "DINUM / INSEE (SIRENE)", use: "Commerces et professionnels de santé" },
  { name: "Annuaire de l'éducation", org: "Ministère de l'Éducation nationale", use: "Établissements scolaires" },
  { name: "Répertoire national des associations", org: "Opendatasoft", use: "Associations déclarées dans la commune" },
  { name: "Dossier complet", org: "INSEE", use: "Statistiques démographiques et socio-économiques" },
  { name: "Résultats électoraux", org: "Ministère de l'Intérieur", use: "Présidentielle 2022, législatives 2022 et 2024" },
  { name: "Historical Weather API", org: "Open-Meteo", use: "Températures et précipitations" },
  { name: "OSRM", org: "Project OSRM", use: "Temps de trajet et distances en voiture" },
];
---

<Layout title="À propos · Où acheter en France">
  <main class="mx-auto max-w-4xl px-4 pt-12 sm:px-6 lg:pt-20">
    <p class="eyebrow">À propos</p>
    <h1 class="mt-4 font-display text-4xl leading-tight font-medium tracking-tight sm:text-5xl">
      Un outil ouvert pour <span class="italic text-accent">choisir où vivre.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      « Où Acheter en France » est un projet open source qui aide à prendre une décision
      éclairée avant un achat immobilier : il rassemble, pour une commune donnée, les
      données publiques les plus utiles et les présente au même endroit.
    </p>

    <section class="mt-16">
      <h2 class="font-display text-2xl font-medium tracking-tight">Sources de données</h2>
      <p class="mt-2 text-sm text-muted">Toutes les données proviennent d'API publiques et ouvertes.</p>
      <ul class="card mt-6 divide-y divide-line overflow-hidden">
        {
          sources.map((source) => (
            <li class="grid gap-1 px-6 py-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] sm:gap-6">
              <div>
                <p class="font-medium text-ink">{source.name}</p>
                <p class="text-xs text-muted">{source.org}</p>
              </div>
              <p class="text-sm text-ink-soft">{source.use}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card mt-12 flex flex-col gap-6 p-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="font-display text-2xl font-medium tracking-tight">Contribuer</h2>
        <p class="mt-2 max-w-lg text-ink-soft">
          Améliorations, signalements de bugs, nouvelles sources de données : toutes les
          contributions sont les bienvenues.
        </p>
      </div>
      <a
        href="https://github.com/alexisducerf/acheter-en-france"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary shrink-0"
      >
        Voir le projet sur GitHub ↗
      </a>
    </section>
  </main>
</Layout>
